// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// Add ENUM for role
enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OTP_Types {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum Feature {
  USER
  CATEGORY
  PRODUCT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantRole {
  STORE_OWNER
  STORE_STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Plan {
  id                     Int            @id @default(autoincrement())
  code                   String         @unique
  name                   String
  description            String?
  priceMonthly           Int            @default(0)
  priceYearly            Int            @default(0)
  currency               String         @default("INR")
  maxProducts            Int            @default(50)
  maxStorageMb           Int            @default(500)
  customDomainAllowed    Boolean        @default(false)
  aiChatbotEnabled       Boolean        @default(false)
  autoProcurementEnabled Boolean        @default(false)
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  tenants                Tenant[]
  subscriptions          Subscription[]
}

model PlatformAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  isDefault            Boolean               @default(false)
  status               TenantStatus          @default(ACTIVE)
  customDomain         String?               @unique
  customDomainVerified Boolean               @default(false)
  planId               Int?
  plan                 Plan?                 @relation(fields: [planId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  branding             TenantBranding?
  users                User[]
  subscriptions        Subscription[]
  paymentConfig        TenantPaymentConfig?
  auditLogs            AuditLog[]
  addresses            Address[]
  categories           Category[]
  files                File[]
  hsns                 Hsn[]
  products             Product[]
  productReviews       ProductReview[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  productNotifications ProductNotification[]
  sizes                Size[]
  colors               Color[]
  otps                 Otp[]
  orders               Order[]
  orderProducts        OrderProducts[]
  stocks               Stock[]
  orderStatusHistories OrderStatusHistory[]
  configs              Config[]
}

model TenantBranding {
  id               Int      @id @default(autoincrement())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeName        String
  tagline          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String   @default("#3C50E0")
  primaryDarkColor String   @default("#1C3FB7")
  accentColor      String   @default("#0EA5E9")
  backgroundColor  String   @default("#F6FAFF")
  surfaceColor     String   @default("#FFFFFF")
  textPrimaryColor String   @default("#1C274C")
  seoTitle         String?
  seoDescription   String?
  aiChatbotActive  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscription {
  id                Int                @id @default(autoincrement())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId            Int
  plan              Plan               @relation(fields: [planId], references: [id])
  provider          String             @default("RAZORPAY")
  providerSubId     String?            @unique
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

model TenantPaymentConfig {
  id                     Int      @id @default(autoincrement())
  tenantId               String   @unique
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider               String   @default("RAZORPAY")
  keyId                  String?
  encryptedKeySecret     String?
  encryptedWebhookSecret String?
  codEnabled             Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model User {
  id                   Int                   @id @default(autoincrement())
  tenantId             String                @default("tenant_smk_default")
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  email                String
  password             String?
  mobile               String?
  role                 Role                  @default(USER)
  tenantRole           TenantRole            @default(CUSTOMER)
  status               Status                @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  orders               Order[]
  addresses            Address[]
  orderStatusHistories OrderStatusHistory[]
  productNotifications ProductNotification[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  productReviews       ProductReview[]
  auditLogs            AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, tenantRole])
  @@index([email])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   String   @default("tenant_smk_default")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  action     String
  entity     String
  entityId   String?
  method     String
  route      String
  statusCode Int
  ipAddress  String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Address {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name      String
  mobile    String
  address   String
  city      String
  pincode   String
  country   String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Category {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("tenant_smk_default")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, title])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model File {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   Feature?
  featureId Int?
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Hsn {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("tenant_smk_default")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  tax       Int
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id            Int                   @id @default(autoincrement())
  tenantId      String                @default("tenant_smk_default")
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant       String?
  title         String
  description   String?
  slug          String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId    Int
  mrp           Float
  price         Float
  Hsn           Hsn?                  @relation(fields: [hsnId], references: [id], onDelete: Restrict)
  hsnId         Int?
  Size          Size?                 @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sizeId        Int?
  Color         Color?                @relation(fields: [colorId], references: [id], onDelete: Restrict)
  colorId       Int?
  status        Status                @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  orderProducts OrderProducts[]
  stocks        Stock[]
  notifications ProductNotification[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       ProductReview[]

  @@unique([tenantId, title])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId, productId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, productId])
  @@index([tenantId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, productId])
  @@index([tenantId])
}

model ProductNotification {
  id         Int       @id @default(autoincrement())
  tenantId   String    @default("tenant_smk_default")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  email      String
  notified   Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, userId, productId])
  @@index([tenantId])
}

model Size {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("tenant_smk_default")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, title])
  @@index([tenantId])
}

model Color {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("tenant_smk_default")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  code      String
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, title])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Otp {
  id         Int       @id @default(autoincrement())
  tenantId   String    @default("tenant_smk_default")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       OTP_Types
  email      String
  otp        String
  meta       Json?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_FAILED
  PLACED
  CONFIRMED
  REJECTED
  SHIPPED
  CANCELLED
  DELIVERED
}

enum PaymentType {
  ONLINE
  COD
}

model Order {
  id                   Int                  @id @default(autoincrement())
  tenantId             String               @default("tenant_smk_default")
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id])
  userId               Int
  orderNo              String
  name                 String
  mobile               String
  address              String
  city                 String
  pincode              String
  country              String
  state                String
  isDiffBillAdd        Boolean
  status               OrderStatus
  paymentType          PaymentType
  totalAmount          Float                @default(0)
  shippingAmount       Float                @default(0)
  paymentOrderId       String?              @unique
  billingInfo          Json?
  notes                String?
  discount             Int                  @default(0)
  additionalInfo       Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orderProducts        OrderProducts[]
  orderStatusHistories OrderStatusHistory[]

  @@unique([tenantId, orderNo])
  @@index([tenantId])
}

model OrderProducts {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Int
  mrp       Int
  tax       Int      @default(0)
  stock     Stock    @relation(fields: [stockId], references: [id])
  stockId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum StockType {
  PRODUCT
  ORDER
  PAYMENT_PENDING
  WITHDRAW
}

model Stock {
  id            Int            @id @default(autoincrement())
  tenantId      String         @default("tenant_smk_default")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          StockType
  product       Product        @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderProducts OrderProducts?

  @@index([tenantId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  tenantId  String      @default("tenant_smk_default")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  user      User        @relation(fields: [userId], references: [id])
  userId    Int
  meta      Json?
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@unique([orderId, status])
  @@index([tenantId])
}

model Config {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("tenant_smk_default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}
