DATABASE_URL="postgres://username:password@localhost:5432/dbname"
JWT_SECRET="your_super_secret_jwt_key"
JWT_EXPIRES_IN="7d"
SERVER_ADDRESS="http://localhost:4000/api/"
FRONTEND_URL="http://localhost:3000"
PORT=4000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

APP_NAME=SMK
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_PENDING_STOCK_EXPIRY_TIME='5 minutes'
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=dams
R2_PUBLIC_BASE_URL=https://pub-your-bucket.r2.dev
R2_SIGNED_URL_TTL_SECONDS=900
R2_BUCKET_PATH=uploads

# Cloudflare Turnstile Bot Protection
# Test secret key: 1x0000000000000000000000000000000AA (always passes)
# Test secret key: 2x0000000000000000000000000000000AA (always blocks)
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Autonomous Inventory Agent Integration
INVENTORY_AGENT_ENABLED=true
# Or alias: INVENTORY_AGENT=enabled
MOCK_ERP_URL=https://ecommerce-agents.onrender.com # Production agent hub or http://localhost:8002 locally
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INVENTORY_EVENTS=inventory-events
KAFKA_TOPIC_RESTOCK_EVENTS=inventory-restock
KAFKA_RESTOCK_CONSUMER_GROUP_ID=smk-backend-restock-group

# Kafka SASL Authentication (Optional - for Confluent Cloud, Upstash, AWS MSK, or password-protected brokers)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL     # "SASL_SSL" (TLS encrypted) or "SASL_PLAINTEXT"
# KAFKA_SASL_MECHANISM=PLAIN          # "PLAIN", "SCRAM-SHA-256", or "SCRAM-SHA-512"
# KAFKA_USERNAME=your-kafka-api-key
# KAFKA_PASSWORD=your-kafka-api-secret

# Kafka SSL / CA Certificate (Optional - for custom CA / self-signed certificates or AWS MSK / Aiven)
# KAFKA_CA_PATH=/path/to/ca.pem        # Path to CA certificate file
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
