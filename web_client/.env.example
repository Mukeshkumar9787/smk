# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Razorpay Payment Gateway Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
NEXT_PUBLIC_RAZORPAY_CHECKOUT_LINK=https://checkout.razorpay.com/v1/checkout.js
NEXT_PUBLIC_PAYMENT_TIMEOUT_SECONDS=300

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMK Customer Support Chatbot Embed Script URL
NEXT_PUBLIC_CHATBOT_EMBED_URL=http://localhost:8005/embed.js

# Cloudflare Turnstile Bot Protection
# Test site key: 1x00000000000000000000AA (always passes)
# Test site key: 2x00000000000000000000AB (always blocks)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
